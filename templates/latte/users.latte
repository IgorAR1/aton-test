<h1>Список пользователей</h1>
Фильтры:

<form id="userFilterForm" method="get">
    <label>
        <input type="checkbox" data-filter="full_name">
        Имя или фамилия:
        <input type="text" name="filter[full_name]" value="{$filter['full_name'] ?? ''}">
    </label>
    <br>

    <label>
        <input type="checkbox" data-filter="country">
        Название страны:
        <input type="text" name="filter[country]" value="{$filter['country'] ?? ''}">
    </label>
    <br>

    <label>
        <input type="checkbox" data-filter="city">
        Название города:
        <input type="text" name="filter[city]" value="{$filter['city'] ?? ''}">
    </label>
    <br>

    <select name="sort">
        <option value="">Без сортировки</option>
        <option value="id" {if ($sort ?? '') === 'id'}selected{/if}>По ID</option>
        <option value="country" {if ($sort ?? '') === 'country'}selected{/if}>По названию страны</option>
        <option value="city" {if ($sort ?? '') === 'city'}selected{/if}>По названию города</option>
        <option value="first_name" {if ($sort ?? '') === 'name'}selected{/if}>По фамилии + имени</option>
    </select>

    <select name="order">
        <option value="asc" {if ($order ?? '') === 'asc'}selected{/if}>По возрастанию</option>
        <option value="desc" {if ($order ?? '') === 'desc'}selected{/if}>По убыванию</option>
    </select>

    <button type="submit">Filter</button>
</form>

<table border="1">
    <tr>
        <th>ID</th>
        <th>First Name</th>
        <th>Last Name</th>
        <th>City</th>
        <th>Country</th>
    </tr>
    {foreach $users as $user}
        <tr>
            <td>{$user->getId()}</td>
            <td>{$user->getFirstName()}</td>
            <td>{$user->getLastName()}</td>
            <td>{$user->getLocation()->city}</td>
            <td>{$user->getLocation()->country}</td>
        </tr>
    {/foreach}
</table>

<script n:syntax="off">
    document.getElementById('filterForm').addEventListener('submit', function (e) {
        const form = e.target;

        // 1. Отключаем невыбранные фильтры
        const checkboxes = form.querySelectorAll('input[type=checkbox][data-filter]');
        checkboxes.forEach(checkbox => {
            const fieldName = checkbox.dataset.filter;
            const input = form.querySelector(`[name="filter[${fieldName}]"]`);
            const isChecked = checkbox.checked;
            const isEmpty = input && input.value.trim() === '';

            if (!isChecked || isEmpty) {
                if (input) input.disabled = true;
                checkbox.disabled = true;
            }
        });

        // 2. Отключаем sort/order если не выбраны
        const sort = form.querySelector('[name="sort"]');
        const order = form.querySelector('[name="order"]');

        if (!sort.value) {
            sort.disabled = true;
            order.disabled = true;

        }

    });
</script>
