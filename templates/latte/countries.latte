<h1>Список стран</h1>

<form id="filterForm" method="get">
    {if session('errors')}
        <ul>
            {foreach session('errors') as $error}
                <li style="color: red">{$error}</li>
            {/foreach}
        </ul>
    {/if}

    <label>
        <input type="checkbox" data-filter="country">
        Название страны:
        <input type="text" name="filter[country]" value="{$filter['country'] ?? ''}">
    </label>
    <br>

    <label>
        <input type="checkbox" data-filter="id">
        ID:
        <input type="text" name="filter[id]" value="{$filter['id'] ?? ''}">
    </label>
    <br>

    <select name="sort">
        <option value="">Без сортировки</option>
        <option value="id" {if ($sort ?? '') === 'id'}selected{/if}>Сортировать по ID</option>
        <option value="country" {if ($sort ?? '') === 'country'}selected{/if}>Сортировать по названию страны</option>
    </select>

    <select name="order">
        <option value="asc" {if ($order ?? '') === 'asc'}selected{/if}>По возрастанию</option>
        <option value="desc" {if ($order ?? '') === 'desc'}selected{/if}>По убыванию</option>
    </select>

    <button type="submit">Фильтровать</button>
</form>

<table border="1">
    <tr>
        <th>ID</th>
        <th>Название</th>
    </tr>
    {foreach $countries as $country}
        <tr>
            <td>{$country->getId()}</td>
            <td>{$country->getName()}</td>
        </tr>
    {/foreach}
</table>

<script n:syntax="off">
    document.getElementById('filterForm').addEventListener('submit', function (e) {
        const form = e.target;

        // 1. Отключаем невыбранные фильтры
        const checkboxes = form.querySelectorAll('input[type=checkbox][data-filter]');
        checkboxes.forEach(checkbox => {
            const fieldName = checkbox.dataset.filter;
            const input = form.querySelector(`[name="filter[${fieldName}]"]`);
            const isChecked = checkbox.checked;
            const isEmpty = input && input.value.trim() === '';

            if (!isChecked || isEmpty) {
                if (input) input.disabled = true;
                checkbox.disabled = true;
            }
        });

        // 2. Отключаем sort/order если не выбраны
        const sort = form.querySelector('[name="sort"]');
        const order = form.querySelector('[name="order"]');

        if (!sort.value) {
            sort.disabled = true;
            order.disabled = true;

        }

    });
</script>

